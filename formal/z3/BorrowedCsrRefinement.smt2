(set-logic AUFLIA)
(set-option :produce-models true)

; Natural graph dimensions and the exact fused-validation charge.
(declare-const vertices Int)
(declare-const edges Int)
(declare-const components Int)
(declare-const candidates Int)
(declare-const validation_work Int)
(declare-const tarjan_work Int)
(declare-const input_clone_slots Int)
(declare-const pipeline_slots Int)
(assert (>= vertices 0))
(assert (>= edges 0))
(assert (>= components 0))
(assert (>= candidates 0))
(assert (<= components vertices))
(assert (<= candidates edges))
(assert (= validation_work (+ 1 vertices edges)))
(assert (= tarjan_work (+ (* 5 vertices) edges)))
(assert (= input_clone_slots 0))
(assert (= pipeline_slots (+ (* 5 vertices) (* 4 components)
                             (* 2 candidates) 2048)))

; Fused validation remains linear.
(push)
(assert (not (<= validation_work (* 2 (+ vertices edges 1)))))
(check-sat)
(pop)

; Tarjan plus validation has the exact conservative operation bound.
(push)
(assert (not (= (+ tarjan_work validation_work)
                (+ (* 6 vertices) (* 2 edges) 1))))
(check-sat)
(pop)

; The borrowed adapter adds no input-clone workspace to the existing bound.
(push)
(assert (not (<= (+ pipeline_slots input_clone_slots)
                 (+ (* 9 vertices) (* 2 edges) 2048))))
(check-sat)
(pop)

; Admitted row bounds make every slice position safe.
(declare-const target_count Int)
(declare-const row_start Int)
(declare-const row_stop Int)
(declare-const position Int)
(assert (>= target_count 0))
(assert (>= row_start 0))
(assert (<= row_start row_stop))
(assert (<= row_stop target_count))
(assert (>= position row_start))
(assert (< position row_stop))
(push)
(assert (not (and (>= position 0) (< position target_count))))
(check-sat)
(pop)

; Range and strict-order admission precede target indexing.
(declare-const target Int)
(declare-const previous_target Int)
(declare-const first_in_row Bool)
(assert (> vertices 0))
(assert (>= target 0))
(assert (< target vertices))
(assert (or first_in_row (< previous_target target)))
(push)
(assert (or (< target 0) (>= target vertices)))
(check-sat)
(pop)
(push)
(assert (and (not first_in_row) (>= previous_target target)))
(check-sat)
(pop)

; Borrowed and owned CSR observations denote the same edge relation.
(declare-fun borrowed_edge (Int Int) Bool)
(declare-fun owned_edge (Int Int) Bool)
(assert (forall ((source Int) (destination Int))
  (= (borrowed_edge source destination)
     (owned_edge source destination))))
(push)
(assert (exists ((source Int) (destination Int))
  (not (= (borrowed_edge source destination)
          (owned_edge source destination)))))
(check-sat)
(pop)

; Cancellation and rejection cannot publish a partial decomposition.
(declare-const canonical_input Bool)
(declare-const admitted Bool)
(declare-const cancelled Bool)
(declare-const published Bool)
(declare-const completed Bool)
(assert (= admitted canonical_input))
(assert (= published (and admitted completed (not cancelled))))
(push)
(assert (and published (or (not canonical_input) (not completed) cancelled)))
(check-sat)
(pop)

(exit)
